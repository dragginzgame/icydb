#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Only refresh paths already selected for this commit. Check for partial staging
# before formatting so refreshing the index cannot absorb unrelated edits.
mapfile -d '' -t staged < <(
  git -C "$ROOT" diff --cached --name-only -z --diff-filter=ACMR -- '*.rs' 'Cargo.toml'
)
for path in "${staged[@]}"; do
  if ! git -C "$ROOT" --literal-pathspecs diff --quiet -- "$path"; then
    printf 'Cannot auto-format partially staged file: %s\n' "$path" >&2
    echo "Finish staging that file before committing. No formatting or staging was performed." >&2
    exit 1
  fi
done

echo "Running pre-commit formatting (Cargo manifests, derives, and Rust code)..."
make --no-print-directory -C "$ROOT" fmt

if ((${#staged[@]})); then
  git -C "$ROOT" --literal-pathspecs add -- "${staged[@]}"
fi

echo "Pre-commit formatting passed; formatted staged files are included in the commit."
