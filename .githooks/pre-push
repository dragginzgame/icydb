#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"

is_zero_sha() {
    [[ "$1" =~ ^0+$ ]]
}

is_tag_deletion() {
    local local_ref="$1"
    local local_sha="$2"
    local remote_ref="$3"

    [[ "${remote_ref}" == refs/tags/* ]] || return 1
    if [[ "${local_ref}" == "(delete)" || "${local_ref}" == "delete" ]]; then
        return 0
    fi
    if [[ "${local_sha}" == "(delete)" || "${local_sha}" == "delete" ]]; then
        return 0
    fi
    is_zero_sha "${local_sha}"
}

ref_count=0
tag_delete_count=0
has_deletion=0
pushed_commits=()
while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ -z "${local_ref}${local_sha}${remote_ref}${remote_sha}" ]]; then
        continue
    fi
    ref_count=$((ref_count + 1))
    if is_tag_deletion "${local_ref}" "${local_sha}" "${remote_ref}"; then
        tag_delete_count=$((tag_delete_count + 1))
    fi
    if is_zero_sha "${local_sha}"; then
        has_deletion=1
        continue
    fi

    pushed_commit="$(git -C "$ROOT" rev-parse --verify "${local_ref}^{commit}" 2>/dev/null || true)"
    if [[ -n "${pushed_commit}" ]]; then
        pushed_commits+=("${pushed_commit}")
    fi
done

if [[ "${ref_count}" -gt 0 && "${ref_count}" -eq "${tag_delete_count}" ]]; then
    echo "Skipping pre-push checks for tag deletion-only push."
    exit 0
fi

# A release gate receipt is valid only for one exact annotated release commit
# mechanically derived from its tested clean candidate. Skip the duplicate
# full gate only when every pushed non-deletion ref resolves to that same
# proven commit. Mixed deletions and unresolvable refs stay on the fail-closed
# ordinary push path.
if [[ "${has_deletion}" -eq 0 && "${#pushed_commits[@]}" -eq "${ref_count}" ]]; then
    receipt_commit="${pushed_commits[0]:-}"
    refs_share_commit=1
    for pushed_commit in "${pushed_commits[@]}"; do
        if [[ "${pushed_commit}" != "${receipt_commit}" ]]; then
            refs_share_commit=0
            break
        fi
    done
    if [[ "${refs_share_commit}" -eq 1 && -n "${receipt_commit}" ]] &&
        "$ROOT/scripts/ci/verify-release-gate-receipt.sh" "${receipt_commit}"; then
        echo "Reusing exact release-gate receipt for ${receipt_commit}; pre-push tests skipped."
        exit 0
    fi
fi

# Derive repo-local cargo paths from the Makefile so hooks stay aligned with
# the repo-owned defaults after the old env shim removal.
export CARGO_HOME="${CARGO_HOME:-$(make --no-print-directory -s -C "$ROOT" print-cargo-home)}"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$(make --no-print-directory -s -C "$ROOT" print-cargo-target-dir)}"

echo "Running pre-push checks (full test gate)..."

# The user-owned push boundary runs the same complete local validation gate
# used for release readiness, including invariants, Clippy, and tests.
make -C "$ROOT" test

echo "Pre-push checks passed."
