type DiagnosticFact = record { tag : nat8; value : nat64 };
type Error = record {
  query_field : opt QueryFieldDiagnostic;
  code : nat16;
  class : nat8;
  origin : nat8;
  facts : vec DiagnosticFact;
};
type ExpectedAcceptedHead = variant {
  Empty;
  Exact : record { fingerprint : blob; revision : nat64 };
};
type QueryFieldDiagnostic = record { field : text; role : nat8 };
type Result = variant { Ok : SchemaMigrationStatusPage; Err : Error };
type SchemaMigrationCommand = variant {
  Abort : record {
    expected_head : ExpectedAcceptedHead;
    expected_plan : blob;
    expected_database : blob;
  };
  Adopt : record {
    expected_head : ExpectedAcceptedHead;
    expected_database : blob;
  };
  Advance : record {
    acknowledged_finding_page : opt nat64;
    expected_head : ExpectedAcceptedHead;
    expected_plan : blob;
    expected_database : blob;
  };
};
type SchemaMigrationEntityTransition = record {
  entity : text;
  to_version : nat32;
  from_version : opt nat32;
};
type SchemaMigrationFinding = record {
  primary_key : blob;
  kind : SchemaMigrationFindingKind;
  entity_tag : nat64;
};
type SchemaMigrationFindingKind = variant {
  Relation;
  Constraint;
  UniqueIndex;
  Transform;
};
type SchemaMigrationPhase = variant {
  Applied;
  Idle;
  Publishing;
  RebuildingIndexes;
  Prepared;
  Rejected;
  ReadyToRewrite;
  Unadopted;
  FinalValidation;
  Adopted;
  RewritingRows;
  Validating;
  Aborted;
};
type SchemaMigrationReceipt = record {
  prior_head : ExpectedAcceptedHead;
  accepted_head : ExpectedAcceptedHead;
  plan_digest : opt blob;
  database_identity : blob;
};
type SchemaMigrationStatusPage = record {
  rows_validated : nat64;
  terminal_receipt : opt SchemaMigrationReceipt;
  accepted_head : ExpectedAcceptedHead;
  plan_digest : opt blob;
  transitions : vec SchemaMigrationEntityTransition;
  database_identity : blob;
  findings : vec SchemaMigrationFinding;
  next_cursor : opt blob;
  phase : SchemaMigrationPhase;
  indexes_rebuilt : nat32;
  rows_rewritten : nat64;
};
type SchemaMigrationStatusRequest = record { cursor : opt blob };
service : {
  icydb_schema_migrate : (SchemaMigrationCommand) -> (Result);
  icydb_schema_migration : (SchemaMigrationStatusRequest) -> (Result) query;
}
