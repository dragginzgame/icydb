+#[test]
+#[ignore = "isolated upstream measurement"]
+fn upstream_startup_and_reads() {
+    let release = env::var("TOKO_MINER_QUALIFICATION_RELEASE_BUILD_ID").unwrap();
+    let caller = Principal::from_slice(&[0x76, 0]);
+    let fixture = fixture(&release, &[caller]);
+    let hub = fixture.unique_role(&"user_hub".parse().unwrap()).unwrap();
+    let shard = enrol(&fixture, hub, caller, 0);
+    advance(&fixture, 20);
+    let controller = fixture.pic().get_controllers(shard)[0];
+    let metrics: Result<icydb::metrics::MetricsReport, candid::Reserved> = fixture
+        .pic()
+        .query_candid_as_or_panic(shard, controller, "icydb_metrics", ());
+    let metrics = metrics.unwrap();
+    let lifecycle = metrics.schema_lifecycle();
+    let phases = [
+        ("lowering", lifecycle.lowering()),
+        ("publication", lifecycle.publication()),
+        ("runtime_compilation", lifecycle.runtime_compilation()),
+        ("cardinality", lifecycle.cardinality()),
+        ("startup_recovery", lifecycle.startup_recovery()),
+    ];
+    let phases: Vec<_> = phases.into_iter().map(|(name, span)| json!({"name": name, "samples": span.samples(), "instructions_total": span.instructions_total(), "instructions_max": span.instructions_max()})).collect();
+    let mut queries = Vec::new();
+    if env::var_os("ICYDB_UPSTREAM_READ_PROBES").is_some() {
+        for name in [
+            "upstream_probe_list_minerals",
+            "upstream_probe_list_industry_catalog",
+            "upstream_probe_get_my_robot",
+        ] {
+            let mut expected = None;
+            for repeat in 0..3 {
+                let reply = fixture
+                    .pic()
+                    .query_call(shard, caller, name, candid::encode_args(()).unwrap())
+                    .unwrap();
+                let (instructions, bytes): (u64, Vec<u8>) = candid::decode_args(&reply).unwrap();
+                let healthy: Result<candid::Reserved, candid::Reserved> =
+                    candid::decode_one(&bytes).unwrap();
+                assert!(
+                    healthy.is_ok(),
+                    "probe must measure a successful application read"
+                );
+                if let Some(ref previous) = expected {
+                    assert_eq!(previous, &bytes, "same response across independent queries");
+                } else {
+                    expected = Some(bytes.clone());
+                }
+                queries.push(json!({"method":name,"repeat":repeat,"instructions":instructions,"response_bytes":bytes}));
+            }
+        }
+    }
+    let schema: Result<Vec<UpstreamEntityDescription>, candid::Reserved> = fixture
+        .pic()
+        .query_candid_as_or_panic(shard, controller, "icydb_schema", ());
+    let entity_names: Vec<_> = schema
+        .unwrap()
+        .into_iter()
+        .map(|entity| entity.entity_path)
+        .collect();
+    let report = json!({"release_build_id":release,"startup_schema_phases":phases,"queries":queries,"accepted_entity_names":entity_names,"shard_consumed_nominal_cycles":consumed_cycles(&fixture,shard).to_string()});
+    fs::write(
+        env::var("ICYDB_UPSTREAM_STARTUP_REPORT").unwrap(),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+    println!("UPSTREAM_STARTUP_REPORT written");
+}
