+fn upstream_clones(
+    fixture: &ManagedComponentGroupFixture,
+    shard: Principal,
+) -> Vec<(String, u64, u64)> {
+    if env::var_os("ICYDB_UPSTREAM_CLONE_PROBES").is_none() {
+        return Vec::new();
+    }
+    fixture.pic().query_candid_as_or_panic(
+        shard,
+        Principal::anonymous(),
+        "upstream_clone_counts",
+        (),
+    )
+}
+
+fn upstream_logs(
+    fixture: &ManagedComponentGroupFixture,
+    shard: Principal,
+    records: &mut std::collections::BTreeMap<u64, String>,
+) {
+    let controller = fixture.pic().get_controllers(shard)[0];
+    for record in fixture
+        .pic()
+        .fetch_canister_logs(shard, controller)
+        .unwrap()
+    {
+        let text = String::from_utf8(record.content).unwrap();
+        records.entry(record.idx).or_insert(text);
+    }
+}
