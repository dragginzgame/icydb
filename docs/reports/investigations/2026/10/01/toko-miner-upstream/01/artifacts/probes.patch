+#[inline(never)]
+fn upstream_clone<T: Clone>(field: &'static str, value: &T) -> T {
+    let start = ic_cdk::api::performance_counter(0);
+    let cloned = value.clone();
+    let instructions = ic_cdk::api::performance_counter(0) - start;
+    UPSTREAM_CLONES.with_borrow_mut(|counts| {
+        let count = counts.entry(field).or_insert((0, 0));
+        count.0 += 1;
+        count.1 += instructions;
+    });
+    cloned
+}
+
+thread_local! { static UPSTREAM_CLONES: std::cell::RefCell<std::collections::BTreeMap<&'static str, (u64,u64)>> = const { std::cell::RefCell::new(std::collections::BTreeMap::new()) }; }
+#[ic_cdk::query]
+fn upstream_clone_counts() -> Vec<(String, u64, u64)> {
+    UPSTREAM_CLONES.with_borrow(|counts| {
+        counts
+            .iter()
+            .map(|(field, (samples, instructions))| (field.to_string(), *samples, *instructions))
+            .collect()
+    })
+}
