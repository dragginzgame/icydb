  "host_probe_source": "\n// Disposable host-only measurement; both frozen Wasms use identical calls.\n#[test]\n#[ignore = \"manual matched-artifact index scan measurement\"]\nfn indexed_range_wasm_cost_probe() {\n    let module = preparation_measurement_wasm();\n    for digits in [20_u32, 4_092] {\n        let fixture = icydb_testing_integration::install_prebuilt_fixture_canister(\"sql_perf\", module.clone());\n        let prepared: Result<(), Error> = fixture.update_candid(\"prepare_indexed_big_integer_fixture\", ()).unwrap();\n        prepared.unwrap();\n        let written: Result<IndexedBigIntegerAttempt, Error> = fixture.update_candid(\"measure_indexed_big_integer_write\", (false, digits, 32_u16)).unwrap();\n        assert_eq!(written.unwrap().outcome.unwrap(), 32);\n        for direction in [\"ASC\", \"DESC\"] {\n            let sql = format!(\"SELECT id FROM PerfAuditIndexedBigInteger WHERE unsigned > 0 ORDER BY unsigned {direction}, id {direction} LIMIT 8\");\n            let explained = query_perf(&fixture, \"query_user_with_perf\", &format!(\"EXPLAIN JSON {sql}\"));\n            let SqlQueryResult::Explain { explain, .. } = explained.result else { panic!(\"explain expected\") };\n            let plan: serde_json::Value = serde_json::from_str(&explain).unwrap();\n            assert_eq!(plan[\"access_decision\"][\"selected\"][\"index_name\"], \"perf_big_unsigned_idx\");\n            println!(\"indexed_range_plan digits={digits} direction={direction} plan={explain}\");\n            for repeat in 0..3 {\n                settle_measurement_rounds(&fixture);\n                let before = fixture.pocket_ic().cycle_balance(fixture.canister_id());\n                let sample: Result<SqlQueryPerfResult, Error> = fixture.update_candid(\"warm_user_query_with_perf\", (sql.clone(),)).unwrap();\n                let cycles = before.checked_sub(fixture.pocket_ic().cycle_balance(fixture.canister_id())).unwrap();\n                let sample = sample.unwrap();\n                let SqlQueryResult::Projection(ref projection) = sample.result else { panic!(\"projection expected\") };\n                assert_eq!(projection.rows.len(), 8);\n                println!(\"indexed_range_cost digits={digits} direction={direction} repeat={repeat} instructions={} cycles={cycles} result={:?}\", sample.instructions, sample.result);\n            }\n        }\n    }\n}\n",
