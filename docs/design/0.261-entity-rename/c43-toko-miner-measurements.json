  "host_probe_patch": "--- /tmp/icydb-c43-toko.YDrded/source/apps/toko_miner/user_hub/src/qualification/opening/costs.rs\t2026-09-23 12:46:33.000000000 +0200\n+++ /tmp/icydb-c43-toko.YDrded/host-app/apps/toko_miner/user_hub/src/qualification/opening/costs.rs\t2026-09-23 13:24:02.646667282 +0200\n@@ -7,10 +7,118 @@\n mod physics;\n \n use super::*;\n+use canic::testing::CanisterInstallExt;\n use serde_json::{Value, json};\n \n const ACTIONS: usize = 64;\n \n+// Host-only measurement: normal managed readiness and same-release restoration,\n+// without a priming update or any change to the deployed application.\n+#[test]\n+#[ignore = \"requires exact managed artefacts\"]\n+fn c43_query_and_same_release_costs() {\n+    let release = env::var(\"TOKO_MINER_QUALIFICATION_RELEASE_BUILD_ID\").expect(\"build\");\n+    let caller = Principal::from_slice(&[0x74; 29]);\n+    let fixture = fixture(&release, &[caller]);\n+    let hub = fixture.unique_role(&\"user_hub\".parse().unwrap()).unwrap();\n+    let before_enrol: Vec<_> = fixture\n+        .nodes()\n+        .iter()\n+        .map(|node| {\n+            (\n+                node.canister_id,\n+                fixture.pic().cycle_balance(node.canister_id),\n+            )\n+        })\n+        .collect();\n+    let shard = enrol(&fixture, hub, caller, 0);\n+    let before = before_enrol.iter().find(|(id, _)| *id == shard).unwrap().1;\n+    let enrolled = fixture.pic().cycle_balance(shard);\n+    let (initial, initial_queries) = c43_queries(&fixture, shard, caller);\n+    let before_cooldown = fixture.pic().cycle_balance(shard);\n+    fixture\n+        .pic()\n+        .wait_out_install_code_rate_limit(Duration::from_mins(5));\n+    let before_upgrade = fixture.pic().cycle_balance(shard);\n+    fixture\n+        .upgrade_same_release(shard, Duration::ZERO)\n+        .expect(\"same-release restore\");\n+    let after_upgrade = fixture.pic().cycle_balance(shard);\n+    let (restored, restored_queries) = c43_queries(&fixture, shard, caller);\n+    let after_ready = fixture.pic().cycle_balance(shard);\n+    assert_eq!(restored, initial, \"field survives same-release restoration\");\n+    let report = json!({\n+        \"release_build_id\": release,\n+        \"post_fixture_shard_balance\": before.to_string(),\n+        \"initialisation_and_fixture_cycles\": null,\n+        \"enrolment_shard_cycles\": before.checked_sub(enrolled).expect(\"no funding\").to_string(),\n+        \"initial_queries\": initial_queries,\n+        \"cooldown_background_cycles\": before_cooldown.checked_sub(before_upgrade).expect(\"no funding\").to_string(),\n+        \"upgrade_delivery_cycles\": before_upgrade.checked_sub(after_upgrade).expect(\"no funding\").to_string(),\n+        \"post_upgrade_readiness_cycles\": after_upgrade.checked_sub(after_ready).expect(\"no funding\").to_string(),\n+        \"restored_queries\": restored_queries,\n+        \"restored_field_equal\": true,\n+        \"query_instructions\": null,\n+        \"scope\": \"First successful caller-owned field read after enrolment or same-release upgrade; fixture readiness may already have prepared the heap. Query instructions are unavailable.\"\n+    });\n+    fs::write(\n+        env::var(\"C43_QUERY_REPORT\").expect(\"report path\"),\n+        serde_json::to_vec_pretty(&report).unwrap(),\n+    )\n+    .unwrap();\n+    println!(\"C43_QUERY_COST {report}\");\n+}\n+\n+fn c43_queries(\n+    fixture: &ManagedComponentGroupFixture,\n+    shard: Principal,\n+    caller: Principal,\n+) -> (FieldProbe, Value) {\n+    let mut rejected = 0;\n+    let mut expected = None;\n+    let mut cycles = Vec::new();\n+    for _ in 0..64 {\n+        let before = fixture.pic().cycle_balance(shard);\n+        let result: Result<Vec<GameplayReadResult<FieldProbe>>, candid::Reserved> =\n+            fixture.pic().query_candid_as_or_panic(\n+                shard,\n+                caller,\n+                \"get_my_gameplay\",\n+                (vec![GameplayRead::Field {\n+                    location_key: \"tok_core\".into(),\n+                }],),\n+            );\n+        let after = fixture.pic().cycle_balance(shard);\n+        let field = result.ok().and_then(|mut rows| match rows.remove(0) {\n+            GameplayReadResult::Field(Ok(field)) => Some(field),\n+            _ => None,\n+        });\n+        if let Some(field) = field {\n+            if let Some(ref prior) = expected {\n+                assert_eq!(prior, &field);\n+            } else {\n+                expected = Some(field);\n+            }\n+            cycles.push(\n+                before\n+                    .checked_sub(after)\n+                    .expect(\"no query funding\")\n+                    .to_string(),\n+            );\n+            if cycles.len() == 3 {\n+                return (\n+                    expected.unwrap(),\n+                    json!({\"rejected_before_ready\": rejected, \"charged_cycles\": cycles, \"repeated_fields_equal\": true}),\n+                );\n+            }\n+        } else {\n+            rejected += 1;\n+            advance(fixture, 1);\n+        }\n+    }\n+    panic!(\"no bounded first-ready query result\");\n+}\n+\n #[test]\n #[ignore = \"requires managed Wasms; run make action-benchmark\"]\n fn direct_batches_report_charged_cycles_and_conserved_work() {\n@@ -38,7 +146,6 @@\n         \"schema_version\": 1, \"release_build_id\": release,\n         \"environment\": \"PocketIC managed application subnet\",\n         \"cycle_measurement\": \"replica balance deltas, not instruction-price estimates\",\n-        \"latency_measurement\": \"collection waits and local execution; not live network latency\",\n         \"trials\": trials,\n     });\n     if let Ok(path) = env::var(\"TOKO_MINER_ACTION_COST_REPORT\") {\n@@ -356,7 +463,6 @@\n ) -> (Receipt, Value) {\n     let bytes = candid::encode_args((&req,)).expect(\"request\").len();\n     let before = fixture.pic().cycle_balance(shard);\n-    let wall = std::time::Instant::now();\n     let receipt = execute(fixture, shard, caller, req.clone());\n     assert!(!receipt.replayed);\n     let after = fixture.pic().cycle_balance(shard);\n@@ -364,7 +470,6 @@\n         \"actions\": req.actions.len(), \"candid_argument_bytes\": bytes,\n         \"balance_before\": before.to_string(), \"balance_after\": after.to_string(),\n         \"net_cycles\": before.checked_sub(after).expect(\"funding invalidates cost trial\").to_string(),\n-        \"host_elapsed_ms\": wall.elapsed().as_secs_f64() * 1000.0,\n         \"oldest_action_queue_ms\": req.actions.len().saturating_sub(1) * 1000,\n     });\n     (receipt, measured)\n",
